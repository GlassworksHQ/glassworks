      "card": { "type": "entities", "entities": ["scene.movie"] } },
    { "what": "B2/I1: a button row (Press, EntityRowControls)", "route": "native",
      "card": { "type": "entities", "entities": ["button.restart"] } },
    { "what": "B2/I1: a lock row (Lock/Unlock, EntityRowControls)", "route": "native",
      "card": { "type": "entities", "entities": ["lock.front_door"] } },
    { "what": "B2/I1: a climate row (HA draws target temperatures)", "route": "frontend",
      "card": { "type": "entities", "entities": ["climate.hall"] } },
