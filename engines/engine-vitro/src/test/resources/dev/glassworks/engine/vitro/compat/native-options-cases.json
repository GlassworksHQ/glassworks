{
  "about": "The strict compat rule's cases, read by NativeOptionsTest (the engine) and vitroCompat.test.ts (the site's checker), so both route each config the same way and word its first reason the same. route: native (drawn by Vitro), island (a custom card the island draws, every script a Lovelace resource) or frontend (its view opens in HA's frontend). reason: the first reason, when the route isn't native.",
  "cards": [
    { "what": "B2/I1: an input_number row (HA draws a slider)", "route": "frontend",
      "card": { "type": "entities", "entities": ["sensor.a", "input_number.target"] } },
    { "what": "B2/I1: an input_select row (HA draws a dropdown)", "route": "frontend",
      "card": { "type": "entities", "entities": [{ "entity": "input_select.mode" }] } },
    { "what": "B2/I1: a script row (HA draws RUN)", "route": "frontend",
      "card": { "type": "entities", "entities": ["script.goodnight"] } },
    { "what": "B2/I1: a scene row (HA draws ACTIVATE)", "route": "frontend",
      "card": { "type": "entities", "entities": ["scene.movie"] } },
    { "what": "B2/I1: a button row (HA draws PRESS)", "route": "frontend",
      "card": { "type": "entities", "entities": ["button.restart"] } },
    { "what": "B2/I1: a lock row (HA draws LOCK/UNLOCK)", "route": "frontend",
      "card": { "type": "entities", "entities": ["lock.front_door"] } },
    { "what": "B2/I1: a climate row (HA draws target temperatures)", "route": "frontend",
      "card": { "type": "entities", "entities": ["climate.hall"] } },
    { "what": "B2/I1: a select row", "route": "frontend",
      "card": { "type": "entities", "entities": ["select.speed"] } },
    { "what": "B2/I1: a number row", "route": "frontend",
      "card": { "type": "entities", "entities": ["number.volume"] } },
    { "what": "B2/I1: an input_datetime row", "route": "frontend",
      "card": { "type": "entities", "entities": ["input_datetime.alarm"] } },
    { "what": "B2/I1: a timer row", "route": "frontend",
      "card": { "type": "entities", "entities": ["timer.laundry"] } },
    { "what": "B2/I1: a media_player row", "route": "frontend",
      "card": { "type": "entities", "entities": ["media_player.kitchen"] } },
    { "what": "B2/I1: a vacuum row (HA draws a toggle)", "route": "frontend",
      "card": { "type": "entities", "entities": ["vacuum.downstairs"] } },
    { "what": "I1: an attribute row", "route": "frontend",
      "card": { "type": "entities", "entities": [{ "type": "attribute", "entity": "sun.sun", "attribute": "elevation" }] } },
    { "what": "I2: a custom row with an entity (drawn as a plain row before)", "route": "frontend",
      "card": { "type": "entities", "entities": [{ "type": "custom:slider-entity-row", "entity": "light.desk" }] } },
    { "what": "I2: a custom row without an entity (left out before)", "route": "frontend",
      "card": { "type": "entities", "entities": [{ "type": "custom:fold-entity-row", "head": { "type": "section", "label": "More" }, "entities": ["light.a"] }] } },
    { "what": "B10/I5: entities header", "route": "frontend",
      "card": { "type": "entities", "entities": ["light.a"], "header": { "type": "picture", "image": "/local/x.png" } } },
    { "what": "B10/I5: a tile feature Vitro doesn't draw", "route": "frontend",
      "card": { "type": "tile", "entity": "alarm_control_panel.home", "features": [{ "type": "alarm-modes" }] } },
    { "what": "B8/I3: tile color", "route": "frontend",
      "card": { "type": "tile", "entity": "light.desk", "color": "red" } },
    { "what": "B8/I3: tile state_content", "route": "frontend",
      "card": { "type": "tile", "entity": "light.desk", "state_content": ["state", "last_changed"] } },
    { "what": "B10/I5: a picture-elements image element", "route": "frontend",
      "card": { "type": "picture-elements", "image": "/local/plan.png", "elements": [{ "type": "image", "entity": "light.a", "image": "/local/on.png", "style": { "left": "50%", "top": "50%" } }] } },
    { "what": "B10/I5: a picture-elements conditional element", "route": "frontend",
      "card": { "type": "picture-elements", "image": "/local/plan.png", "elements": [{ "type": "conditional", "conditions": [{ "entity": "binary_sensor.door", "state": "on" }], "elements": [{ "type": "state-icon", "entity": "binary_sensor.door", "style": { "left": "10%", "top": "10%" } }] }] } },
    { "what": "B10/I5: a custom picture-elements element", "route": "frontend",
      "card": { "type": "picture-elements", "image": "/local/plan.png", "elements": [{ "type": "custom:hui-element", "card_type": "tile", "entity": "light.a", "style": { "left": "10%", "top": "10%" } }] } },
    { "what": "B4/I12: double_tap_action on a tile", "route": "frontend",
      "card": { "type": "tile", "entity": "light.desk", "double_tap_action": { "action": "toggle" } } },
    { "what": "B4/I12: an assist tap on a button", "route": "frontend",
      "card": { "type": "button", "entity": "light.desk", "tap_action": { "action": "assist" } } },
    { "what": "B4/I12: a fire-dom-event hold on a tile", "route": "frontend",
      "card": { "type": "tile", "entity": "light.desk", "hold_action": { "action": "fire-dom-event", "browser_mod": { "service": "browser_mod.popup" } } } },
    { "what": "B13/I12: more-info with its own entity", "route": "frontend",
      "card": { "type": "tile", "entity": "light.desk", "hold_action": { "action": "more-info", "entity": "sensor.power" } } },
    { "what": "B11: navigate to a #hash (a Bubble pop-up)", "route": "frontend",
      "card": { "type": "button", "entity": "light.desk", "tap_action": { "action": "navigate", "navigation_path": "#kitchen" } } },
    { "what": "I6: entity-filter conditions", "route": "frontend",
      "card": { "type": "entity-filter", "entities": ["light.a", "light.b"], "conditions": [{ "condition": "state", "state": "on" }] } },
    { "what": "I6: entity-filter with an operator state_filter", "route": "frontend",
      "card": { "type": "entity-filter", "entities": ["sensor.a"], "state_filter": [{ "operator": ">", "value": 20 }] } },
    { "what": "I6: entity-filter whose inner card isn't an entities card", "route": "frontend",
      "card": { "type": "entity-filter", "entities": ["light.a"], "state_filter": ["on"], "card": { "type": "glance" } } },
    { "what": "B12/I7: auto-entities area filter", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "filter": { "include": [{ "area": "kitchen" }] } } },
    { "what": "B12/I7: auto-entities label filter", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "filter": { "include": [{ "domain": "light", "label": "upstairs" }] } } },
    { "what": "B12/I7: auto-entities template filter", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "filter": { "template": "{{ states.light | map(attribute='entity_id') | list }}" } } },
    { "what": "auto-entities' explicit entries are rows of its entities card", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "entities": ["input_select.mode"] } },
    { "what": "auto-entities' generated cards are checked too (a rule's options)", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card_param": "cards", "card": { "type": "grid" }, "filter": { "include": [{ "domain": "light", "options": { "color": "red" } }] } } },
    { "what": "an auto-entities entry without an entity (Vitro drops it)", "route": "frontend",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "entities": ["light.a", { "type": "divider" }] } },
    { "what": "a built-in card Vitro has no renderer for", "route": "frontend", "reason": "the built-in `map` card",
      "card": { "type": "map", "entities": ["person.a"] } },
    { "what": "B5: clock-weather-card (no clock natively)", "route": "island",
      "card": { "type": "custom:clock-weather-card", "entity": "weather.home" } },
    { "what": "B5: Bubble Card slider button", "route": "island",
      "card": { "type": "custom:bubble-card", "card_type": "button", "button_type": "slider", "entity": "light.desk" } },
    { "what": "B5: Bubble Card button_action", "route": "island",
      "card": { "type": "custom:bubble-card", "card_type": "button", "entity": "light.desk", "button_action": { "tap_action": { "action": "navigate", "navigation_path": "/lovelace/kitchen" } } } },
    { "what": "B5: modern-circular-gauge", "route": "island",
      "card": { "type": "custom:modern-circular-gauge", "entity": "sensor.a" } },
    { "what": "B5: bar-card", "route": "island",
      "card": { "type": "custom:bar-card", "entity": "sensor.a" } },
    { "what": "B5: mini-media-player", "route": "island",
      "card": { "type": "custom:mini-media-player", "entity": "media_player.kitchen" } },
    { "what": "B5: mini-graph-card", "route": "island",
      "card": { "type": "custom:mini-graph-card", "entities": ["sensor.a"] } },
    { "what": "B7: Mushroom icon_color", "route": "island",
      "card": { "type": "custom:mushroom-entity-card", "entity": "light.desk", "icon_color": "amber" } },
    { "what": "plain tile", "route": "native",
      "card": { "type": "tile", "entity": "light.desk" } },
    { "what": "tile with features Vitro draws and the actions it runs", "route": "native",
      "card": { "type": "tile", "entity": "light.desk", "features": [{ "type": "light-brightness" }], "tap_action": { "action": "toggle" }, "hold_action": { "action": "more-info" } } },
    { "what": "entities rows Vitro draws", "route": "native",
      "card": { "type": "entities", "title": "Kitchen", "entities": ["sensor.a", "binary_sensor.door", { "type": "divider" }, "input_boolean.guests", { "entity": "light.desk", "name": "Desk" }, "switch.fan"] } },
    { "what": "a button with a navigate tap", "route": "native",
      "card": { "type": "button", "entity": "light.desk", "tap_action": { "action": "navigate", "navigation_path": "/lovelace/kitchen" } } },
    { "what": "B5: even a plain Bubble Card button (no on-fill, a state line Bubble hides)", "route": "island",
      "card": { "type": "custom:bubble-card", "card_type": "button", "entity": "light.desk" } },
    { "what": "a plain Mushroom entity card", "route": "native",
      "card": { "type": "custom:mushroom-entity-card", "entity": "light.desk" } },
    { "what": "auto-entities with rules Vitro evaluates", "route": "native",
      "card": { "type": "custom:auto-entities", "card": { "type": "entities" }, "filter": { "include": [{ "domain": "light", "state": "on" }] } } }
  ],
  "views": [
    { "what": "I8: a typed badge", "route": "frontend",
      "view": { "badges": [{ "type": "entity-filter", "entities": ["light.a"], "state_filter": ["on"] }], "cards": [] } },
    { "what": "I8: a custom badge", "route": "frontend",
      "view": { "badges": [{ "type": "custom:mushroom-template-badge", "content": "Hi" }], "cards": [] } },
    { "what": "I8: an entity badge with a color", "route": "frontend",
      "view": { "badges": [{ "type": "entity", "entity": "light.a", "color": "red" }], "cards": [] } },
    { "what": "I11: a sections view header", "route": "frontend",
      "view": { "type": "sections", "header": { "card": { "type": "markdown", "content": "# Hi" } }, "sections": [] } },
    { "what": "I11: a view footer", "route": "frontend",
      "view": { "type": "sections", "footer": { "card": { "type": "markdown", "content": "x" } }, "sections": [] } },
    { "what": "I11: a sections view sidebar", "route": "frontend",
      "view": { "type": "sections", "sidebar": { "sections": [] }, "sections": [] } },
    { "what": "a string badge (HA shows its name, Vitro doesn't yet)", "route": "frontend",
      "view": { "badges": ["light.a"], "cards": [] } },
    { "what": "I14: a view_columns visibility condition", "route": "frontend",
      "view": { "cards": [{ "type": "tile", "entity": "light.a", "visibility": [{ "condition": "view_columns", "min": 2 }] }] } },
    { "what": "a plain sections view with entity badges", "route": "native",
      "view": { "title": "Home", "path": "home", "icon": "mdi:home", "type": "sections", "max_columns": 4, "badges": [{ "type": "entity", "entity": "light.a", "show_name": true }, { "entity": "sensor.b", "show_name": false, "show_icon": true }], "sections": [{ "type": "grid", "cards": [{ "type": "tile", "entity": "light.a" }] }] } },
    { "what": "a panel view builds its first card only", "route": "native",
      "view": { "panel": true, "cards": [{ "type": "tile", "entity": "light.a" }, { "type": "tile", "entity": "light.a", "color": "red" }] } },
    { "what": "a plain masonry view", "route": "native",
      "view": { "title": "Home", "path": "home", "theme": "Backend-selected", "cards": [{ "type": "tile", "entity": "light.a" }] } }
  ]
}
