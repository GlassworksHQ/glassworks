{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "refract",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "refract.glassworks.dev", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://kiln.glassworks.dev,http://localhost:5174,http://localhost:5173",
    "UPSTREAM_TIMEOUT_MS": "30000"
  },
  "ratelimits": [
    { "name": "FULL_DOWNLOADS", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RESUMES", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } },
    { "name": "SMALL_FILES", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
