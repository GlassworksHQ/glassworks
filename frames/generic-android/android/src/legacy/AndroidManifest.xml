<?xml version="1.0" encoding="utf-8"?>
<!-- The legacy build (#198), over the app's manifest (src/main): Android 6-7 on GeckoView 144. The Glassworks
     modules below declare minSdk 26; this build runs them from API 23, so it overrides their floor. What they call
     above API 23 is listed and guarded: tools/legacy/api23-report.py and CI's api23 job, which also lints this
     build (docs/research/legacy-engine.md). The libraries in libs/ and the legacy engine are minSdk 23 already. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The setup hotspot on Android 6-7: the hidden setWifiApEnabled checks WRITE_SETTINGS (the app-op, or this
         permission). A system app gets it at install, and an update too ("preinstalled"), so the Mirror needs no
         new flash. Elsewhere the user allows it as "Modify system settings". Android 8+ uses the local-only
         hotspot, which doesn't need it, so the generic build doesn't ask
         (frames/lululemon-mirror/research/privileged-app.md). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-sdk tools:overrideLibrary="dev.glassworks.core,dev.glassworks.paneapi,dev.glassworks.panes.assist,dev.glassworks.panes.timers,dev.glassworks.panes.sendspin,dev.glassworks.panes.camera,dev.glassworks.panes.diagnostics" />
</manifest>
