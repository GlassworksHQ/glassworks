<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: the Glassworks stack on flat night (docs/branding.md: the panel's screens are always
     night). The mark is the launch splash's (branding/boot/splash_mark.py), which keeps the stack inside the
     middle two thirds, the same safe zone an adaptive icon's 72 of 108 dp is. Android 8+ only: minSdk 26. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/night" />
    <foreground android:drawable="@drawable/glassworks_mark" />
    <monochrome android:drawable="@drawable/glassworks_mark" />
</adaptive-icon>
