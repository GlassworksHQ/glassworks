{
  "id": "generic-android",
  "kind": "device",
  "name": "Generic Android",
  "brand": "Generic",
  "aka": "Tablets, old phones, other Android panels",
  "status": "stable",
  "summary": "Core plus the panes that need no special hardware. No root.",
  "tagline": "Any Android device, as an app. No root.",
  "legacy": "On Android 6–7, legacy: frozen engine, your Home Assistant only",
  "kiln": "/android",
  "model": {
    "body": {
      "shape": "rect",
      "width": 250,
      "height": 156,
      "depth": 7,
      "radius": 11
    },
    "bezel": 11,
    "screen": {
      "radius": 5
    },
    "sides": {
      "dark": "#0c0d10",
      "light": "#3b3f49"
    },
    "finish": "glass",
    "mount": "wall"
  },
  "render": "render.webp",
  "abis": ["arm64-v8a", "armeabi-v7a"],
  "specs": [
    {
      "label": "Radio",
      "value": "None"
    },
    {
      "label": "Presence",
      "value": "Whatever sensors the device has"
    },
    {
      "label": "Audio",
      "value": "Whatever the device has"
    },
    {
      "label": "Root",
      "value": "Not needed"
    }
  ],
  "panes": {
    "assist": {
      "support": "depends",
      "note": "Needs a microphone."
    },
    "timers": {
      "support": "depends",
      "note": "Needs Assist."
    },
    "sendspin": {
      "support": "depends",
      "note": "Needs a speaker."
    },
    "bluetooth-proxy": {
      "support": "depends",
      "note": "Needs Bluetooth LE. Both builds have it."
    },
    "camera": {
      "support": "depends",
      "note": "Needs a camera. Both builds have it."
    },
    "radio": {
      "support": "no",
      "note": "No supported radio."
    },
    "wall-base": {
      "support": "no",
      "note": "S1 only."
    }
  },
  "install": {
    "how": "It will install as a normal app."
  },
  "ratings": {
    "difficulty": {
      "value": "easy",
      "detail": "Install an app"
    },
    "reversible": {
      "value": "yes",
      "detail": "Uninstall the app"
    },
    "modifiesAndroid": {
      "value": "no"
    },
    "root": {
      "value": "none"
    },
    "opensDevice": {
      "value": "no"
    },
    "vendorApps": {
      "value": "kept"
    },
    "wipes": {
      "value": "no"
    },
    "backup": {
      "value": "none"
    },
    "updates": {
      "value": "ha"
    }
  },
  "facts": {
    "install": ["usb-debugging"],
    "kiosk": { "onlyHome": true },
    "setup": ["screen", "computer"],
    "panelRuns": false,
    "unverified": ["install", "kiosk", "setup"],
    "notes": {
      "install": "Android 6 also asks for a tap on Always, to keep Glassworks as the home app.",
      "silentUpdates": "Depends on the device: Android 12 or newer can update the app with no tap once Install unknown apps is allowed; older Android asks for one unless the app is device owner."
    }
  },
  "release": {
    "lines": {
      "generic-android": {
        "title": "Glassworks for generic Android",
        "tag": "generic-android-v{version}",
        "changelog": "frames/generic-android/CHANGELOG.md",
        "build": "gradle",
        "task": ":generic-android:assembleRelease",
        "apk": "frames/generic-android/android/build/outputs/apk/release/generic-android-release.apk",
        "package": "dev.glassworks.generic_android",
        "minSdk": 26,
        "writeSettings": false,
        "assets": { "*": "glassworks-generic-android-{abi}-{version}.apk" }
      },
      "generic-android-legacy": {
        "title": "Glassworks for generic Android, legacy build",
        "tag": "generic-android-legacy-v{version}",
        "changelog": "frames/generic-android/CHANGELOG.md",
        "build": "gradle",
        "task": ":generic-android:assembleLegacy",
        "apk": "frames/generic-android/android/build/outputs/apk/legacy/generic-android-legacy.apk",
        "package": "dev.glassworks.generic_android.legacy",
        "minSdk": 23,
        "writeSettings": true,
        "assets": { "*": "glassworks-generic-android-legacy-{abi}-{version}.apk" }
      }
    },
    "app": ["generic-android", "generic-android-legacy"]
  }
}
