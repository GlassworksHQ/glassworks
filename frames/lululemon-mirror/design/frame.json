      "value": "removed",
      "detail": "With the rest of the stock software"
    },
    "wipes": {
      "value": "yes"
    },
    "backup": {
      "value": "unavailable",
      "detail": "There's no way to save the stock image first"
    },
    "updates": {
      "value": "ha"
    }
