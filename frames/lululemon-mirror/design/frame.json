      "note": "It has a microphone. In the legacy build."
    },
    "timers": {
      "support": "alpha",
      "note": "Needs Assist."
    },
    "sendspin": {
      "support": "alpha",
      "note": "It has stereo speakers. In the legacy build."
    },
    "notifications": {
      "support": "alpha",
      "note": "In the legacy build. No touch, so an urgent one with no tag or timeout closes after 2 minutes. Not yet run on a Mirror."
    },
    "bluetooth-proxy": {
      "support": "alpha",
      "note": "It has Bluetooth LE (its WCN3660B, read from a teardown). In the legacy build. It scans only once the location permission is granted, which Kiln doesn't do yet. Not yet run on a Mirror."
    },
    "camera": {
      "support": "alpha",
      "note": "It has a camera (5 MP, front). In the legacy build: presence wakes the screen when someone walks up, and no image leaves the Mirror in Presence only. Off until turned on; Kiln grants the camera. The live stream costs memory the dashboard needs, so with it on the dashboard reloads more often."
    },
    "diagnostics": {
      "support": "alpha",
      "note": "In the legacy build, with no CPU temperature. Not yet run on a Mirror."
    },
    "radio": {
      "support": "no",
      "note": "No Zigbee or Thread radio."
    },
    "wall-base": {
      "support": "no",
      "note": "S1 only."
    }
  },
  "install": {
    "how": "It installs by flashing system and userdata over fastboot from a computer."
  },
  "ratings": {
    "difficulty": {
      "value": "medium",
