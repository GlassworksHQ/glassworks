{
  "$comment": "Kiln's install for this frame, as data. Format: docs/design/kiln/frames-as-data.md. A draft (#621): the contract (kiln/apps/kiln/test/contract) reads route, touch and each step's id, writes, reboots, downloads and taps; the engine reads the rest from phase 2.",
  "route": "/lululemon-mirror",
  "touch": false,
  "flows": {
    "fastboot": {
      "steps": [
        { "id": "image", "transport": "none", "inputs": ["apk", "home-assistant", "wifi"], "downloads": ["glass-panes-system"] },
        { "id": "fastboot", "transport": "fastboot", "enter": { "how": "button", "reachable": false, "why": "VOL- is on a board inside the case. On the Glass Panes image the Mirror runs adb, so phase 2 enters fastboot with adb reboot bootloader." }, "checks": ["fastboot-vars", "partition-sizes"] },
        { "id": "install", "transport": "fastboot", "writes": true, "reboots": true, "backup": false },
        { "id": "first-boot", "transport": "adb", "enter": { "how": "boot", "key": "userdata" }, "writes": true }
      ],
      "then": "set-up"
    },
    "app": {
      "steps": [
        { "id": "connect", "transport": "adb", "enter": { "how": "usb-debugging", "key": "glass-panes" }, "inputs": ["apk", "home-assistant"], "checks": ["android-6", "free-space"] },
        { "id": "install", "transport": "adb", "writes": true }
      ],
      "then": "set-up"
    }
  },
  "wayBack": { "how": "flash-images", "images": ["glass-panes-system", "glass-panes-userdata"] }
}
