<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the BootReceiver start the activity from the background on Android 10+
         (grant with: adb shell appops set <pkg> SYSTEM_ALERT_WINDOW allow). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- With the location service type, Android 10 lets the screen-off Wi-Fi scans use location (#3). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- KioskService's type when neither of the two above is granted: Android 14 refuses a service without a type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The camera pane (#117): presence with the screen off, and ONVIF discovery (multicast). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App updates without the boot image's root update service (update/UpdateManager.kt): a
         PackageInstaller session, confirmed on the panel's screen. On Android 12+ the second one lets
         the app update itself without the tap, once "Install unknown apps" is allowed (#277). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Optional, granted over adb (`pm grant <pkg> android.permission.WRITE_SECURE_SETTINGS`):
         lets the app set the proximity sensor's presence range (secure proximity_threshold). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Improv Wi-Fi via BLE (improv/): LE advertising + GATT server, Wi-Fi scan/connect.
         BLUETOOTH/BLUETOOTH_ADMIN are install-time on API <= 30; ADVERTISE/CONNECT replace them on 31+.
         Scan results and the current SSID need ACCESS_FINE_LOCATION + location mode on Android 10
         (a device-owner app grants it to itself; otherwise `pm grant`). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The setup hotspot (#197): from Android 13 a local-only hotspot needs "Nearby devices", asked for on the
         setup screen with its reason; it never finds where the panel is. Android 6-7 start the hotspot through
         the hidden setWifiApEnabled, which wants WRITE_SETTINGS; the S1 (Android 10) never takes that way. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wall base support binds to the stock LocalService (package visibility, targetSdk 30+). -->
    <queries>
        <package android:name="com.lumi.systemmanager" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name="dev.glassworks.s1.KioskApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kiosk"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <!-- Its intent extras change settings (the dashboard's address, the API key, remote debugging), so
             starting it takes WRITE_SECURE_SETTINGS (#374): adb's shell holds it (Kiln, Clarity), and
             Android 10 lets root (the root helper), the system (HOME) and the app itself start it without
             it (ActivityManager.checkComponentPermission). Other apps can't. It stays the HOME activity,
             under this name: panels store it as their HOME, and BootSplash relies on it. -->
        <activity
            android:name="sh.edm.s1kiosk.MainActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="false"
            android:stateNotNeeded="true"
            android:excludeFromRecents="false">
            <!-- Allows choosing this app as the HOME launcher (replacing the Aqara launcher). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The launcher icon's way in (a tablet's app drawer): no permission, and the app drops its
             extras (AppParts.trustsExtras). No HOME filter: a second HOME would tie with MainActivity. -->
        <activity-alias
            android:name="sh.edm.s1kiosk.Launcher"
            android:targetActivity="sh.edm.s1kiosk.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Our HOME while the user is still locked after a boot (direct boot), instead of Aqara's
             FallbackHome (priority -1000): the loading screen until unlock, then MainActivity. Priority
             -100: above FallbackHome, below MainActivity (0), so they never tie (BootSplash.kt has the
             AOSP 10 details). Ships disabled: MainActivity enables it only while no other app's HOME
             could tie with ours (BootSplashActivity.sync). Own process: nothing of the app's
             credential-encrypted state is touched before unlock. -->
        <activity
            android:name="dev.glassworks.s1.BootSplashActivity"
            android:enabled="false"
            android:exported="true"
            android:directBootAware="true"
            android:process=":boot"
            android:taskAffinity="dev.glassworks.s1.boot"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation">
            <intent-filter android:priority="-100">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Owns the sensor/screen policy (and the voice satellite) while the screen is off. -->
        <service
            android:name="dev.glassworks.KioskService"
            android:exported="false"
            android:foregroundServiceType="microphone|location|connectedDevice|camera" />

        <!-- Optional device admin (force-lock only) to switch the screen off instantly. -->
        <receiver
            android:name="sh.edm.s1kiosk.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Improv intent extras from adb (improv=true, release_device_owner=true; see ImprovActivity).
             WRITE_SECURE_SETTINGS: adb shell holds it, normal apps can't. -->
        <activity
            android:name="sh.edm.s1kiosk.improv.ImprovActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The camera pane's settings from adb (CameraAdbActivity). WRITE_SECURE_SETTINGS: adb shell
             holds it, normal apps can't. -->
        <activity
            android:name="dev.glassworks.camera.CameraAdbActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- PackageInstaller session status for app updates (update/UpdateInstallReceiver.kt). -->
        <receiver
            android:name="sh.edm.s1kiosk.update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name="sh.edm.s1kiosk.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
