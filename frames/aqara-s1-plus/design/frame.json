    },
    {
      "label": "Screen",
      "value": "1440 × 720"
    },
    {
      "label": "Radio",
      "value": "EFR32MG21 on SPI, RCP firmware"
    },
    {
      "label": "Presence",
      "value": "VI5300 time-of-flight sensor"
    },
    {
      "label": "Audio",
      "value": "Microphone and speaker"
    },
    {
      "label": "Extras",
      "value": "Wired wall base on a UART"
    },
    {
      "label": "Root",
      "value": "FEL, then a patched boot image"
    }
  ],
  "provides": ["microphone", "speaker", "silabs-radio", "s1-wall-base", "bluetooth-le"],
  "agent": {
    "capabilities": ["radio-mode", "radio-firewall", "radio-firmware", "frame-bundle", "app-updates", "time-zone", "hotspot-portal", "hotspot-name", "bluetooth-address"]
