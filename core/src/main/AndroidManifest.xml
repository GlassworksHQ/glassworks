<?xml version="1.0" encoding="utf-8"?>
<!-- The core's part of both apps' manifests. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- From Android 11 an app sees only the packages it names here. GenericAndroid.dock looks for Google's dock manager. -->
    <queries>
        <package android:name="com.google.android.apps.nest.dockmanager.app" />
    </queries>
</manifest>
